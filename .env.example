# Nakili faili hili kuwa .env kisha jaza thamani zako. USIWEKE .env kwenye git.

DEBUG=True
SECRET_KEY=badilisha-hii-kuwa-siri-ndefu
ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# CSRF_TRUSTED_ORIGINS=https://jamiilite.example.com

# --- Supabase Postgres ---
# Supabase Dashboard -> Connect -> Session pooler (port 5432).
# Badilisha [PASSWORD] kuwa password ya database yako.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# --- Supabase Storage (picha) ---
# Storage -> Settings -> S3 Connection. Tengeneza "access key" mpya hapo.
# Bucket iwe public ili logo zionekane kwenye ukurasa wa kulipia.
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=jamiilite-media
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Malipo ---
# "sandbox" inathibitisha malipo bila pesa halisi (majaribio tu).
PAYMENT_PROVIDER=sandbox

# --- Anwani ambazo MikroTik inazitumia kufikia mfumo ---
# Maabara ya VirtualBox: 10.0.2.2. Server halisi: domain yako (HTTPS) na IP ya server.
JAMIILITE_PUBLIC_URL=http://10.0.2.2:8000
RADIUS_PUBLIC_ADDRESS=10.0.2.2

# --- Tovuti ya hadhara ---
# Namba ya WhatsApp ya kupokea wateja wapya (bila +). Ikiachwa wazi, vitufe vinaelekeza kwenye Mahitaji.
JAMIILITE_WHATSAPP_NUMBER=
JAMIILITE_COMMISSION_PERCENT=5
