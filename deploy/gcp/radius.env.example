# Mipangilio ya RADIUS server kwenye Google Cloud. Faili hili linakaa /etc/jamiilite/radius.env
# Jaza thamani zote zenye BADILISHA, kisha: sudo systemctl restart jamiilite-radius

DEBUG=False
# Server hii haipokei picha, kwa hiyo haihitaji keys za Supabase Storage.
JAMIILITE_NO_MEDIA=True
# Siri yoyote ndefu. RADIUS haiitumii kusaini kitu, kwa hiyo si lazima ifanane na ya Render.
SECRET_KEY=BADILISHA-weka-siri-ndefu-hapa

# Ile ile ya Render: Supabase -> Connect -> Session pooler (port 5432, IPv4)
DATABASE_URL=BADILISHA-postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Router za zamani (kabla ya RouterOS 7.15) hazitumi Message-Authenticator.
# Ziache True isipokuwa una router ya zamani.
RADIUS_REQUIRE_MESSAGE_AUTHENTICATOR=True
